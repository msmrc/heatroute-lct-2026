HEATROUTE_REDIS_URL=redis://localhost:56379/0
HEATROUTE_CELERY_BROKER_URL=redis://localhost:56379/1
HEATROUTE_CELERY_RESULT_BACKEND=redis://localhost:56379/2
HEATROUTE_ARTIFACT_ROOT=artifacts
HEATROUTE_DEMO_MODE=true
