# Copy to /opt/heatroute/.env.vps and set mode 600. Never commit the real file.
POSTGRES_DB=heatroute
POSTGRES_USER=heatroute
POSTGRES_PASSWORD=replace-with-a-long-random-value
HEATROUTE_SESSION_SECRET=replace-with-at-least-32-random-characters
HEATROUTE_LOG_LEVEL=INFO

# Only the password-protected gateway is public.
PUBLIC_HTTP_PORT=80
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=55432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_HOST_PORT=56379
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=5173
