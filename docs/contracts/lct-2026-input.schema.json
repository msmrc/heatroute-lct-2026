{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heatroute.dragons.team/contracts/lct-2026-input.schema.json",
  "title": "HeatRoute LCT 2026 strict input",
  "description": "Published seven-type organizer input contract. Cross-feature IDs, references, topology and geometry validity are additionally checked by the streaming Java inspector.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/source" },
          { "$ref": "#/$defs/heatNetwork" },
          { "$ref": "#/$defs/heatChamber" },
          { "$ref": "#/$defs/oksFuture" },
          { "$ref": "#/$defs/oksConnectionPoint" },
          { "$ref": "#/$defs/oksExisting" },
          { "$ref": "#/$defs/restriction" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "diameter": {
      "type": "integer",
      "enum": [50, 65, 80, 100, 125, 150, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 1200, 1400]
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "items": false
    },
    "point": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" }
      }
    },
    "lineString": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
      }
    },
    "multiLineString": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiLineString" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/position" } }
        }
      }
    },
    "linearRing": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/position" } },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
      }
    },
    "multiPolygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/linearRing" } }
        }
      }
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": { "type": { "const": "Feature" } }
    },
    "source": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "source" }
              }
            }
          }
        }
      ]
    },
    "heatNetwork": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/lineString" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "diameter", "flow_tph", "upstream_object_id"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "heat_network" },
                "diameter": { "$ref": "#/$defs/diameter" },
                "flow_tph": { "$ref": "#/$defs/positiveNumber" },
                "upstream_object_id": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      ]
    },
    "heatChamber": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "diameter", "upstream_object_id"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "heat_chamber" },
                "diameter": { "$ref": "#/$defs/diameter" },
                "upstream_object_id": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      ]
    },
    "oksFuture": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": { "oneOf": [{ "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/multiPolygon" }] },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "flow_tph", "heat_load"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "oks_future" },
                "flow_tph": { "$ref": "#/$defs/positiveNumber" },
                "heat_load": { "$ref": "#/$defs/positiveNumber" }
              }
            }
          }
        }
      ]
    },
    "oksConnectionPoint": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "oks_id"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "oks_connection_point" },
                "oks_id": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      ]
    },
    "oksExisting": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": { "oneOf": [{ "$ref": "#/$defs/polygon" }, { "$ref": "#/$defs/multiPolygon" }] },
            "properties": {
              "type": "object",
              "required": ["id", "object_type"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "oks_existing" }
              }
            }
          }
        }
      ]
    },
    "restriction": {
      "allOf": [
        { "$ref": "#/$defs/feature" },
        {
          "properties": {
            "geometry": {
              "oneOf": [
                { "$ref": "#/$defs/lineString" },
                { "$ref": "#/$defs/multiLineString" },
                { "$ref": "#/$defs/polygon" },
                { "$ref": "#/$defs/multiPolygon" }
              ]
            },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "restriction_type"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "restriction" },
                "restriction_type": {
                  "enum": ["park", "social_area", "prohibited_site", "water", "road", "tram_tracks", "gas_pipeline", "power_cable", "heat_network"]
                }
              }
            }
          }
        }
      ]
    }
  }
}
