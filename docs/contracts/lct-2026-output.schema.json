{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heatroute.dragons.team/contracts/lct-2026-output.schema.json",
  "title": "HeatRoute LCT 2026 official result",
  "description": "Strict GeoJSON result contract. Cross-feature uniqueness, references and exactly one summary per variant are additionally checked by OfficialOutputContractValidator.",
  "type": "object",
  "required": ["type", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/heatNetwork" },
          { "$ref": "#/$defs/tieIn" },
          { "$ref": "#/$defs/networkReconstruction" },
          { "$ref": "#/$defs/heatChamber" },
          { "$ref": "#/$defs/chamberReconstruction" },
          { "$ref": "#/$defs/technicalNode" },
          { "$ref": "#/$defs/variantSummary" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "money": { "type": "number", "minimum": 0 },
    "length": { "type": "number", "minimum": 0 },
    "flow": { "type": "number", "minimum": 0 },
    "depth": { "type": "number", "minimum": 0 },
    "diameter": {
      "type": "integer",
      "enum": [50, 65, 80, 100, 125, 150, 200, 250, 300, 400, 500, 600, 700, 800, 900, 1000, 1200, 1400]
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number" }
      ],
      "items": false
    },
    "point": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" }
      }
    },
    "lineString": {
      "type": "object",
      "required": ["type", "coordinates"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/position" }
        }
      }
    },
    "featureEnvelope": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Feature" },
        "geometry": {},
        "properties": {}
      }
    },
    "commonProperties": {
      "type": "object",
      "required": ["id", "object_type", "variant_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "object_type": { "type": "string" },
        "variant_id": { "$ref": "#/$defs/id" }
      }
    },
    "heatNetwork": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/lineString" },
            "properties": {
              "allOf": [
                { "$ref": "#/$defs/commonProperties" },
                {
                  "type": "object",
                  "required": ["id", "object_type", "variant_id", "start_node_id", "end_node_id", "flow_tph", "diameter", "length", "laying_method", "cost"],
                  "additionalProperties": false,
                  "properties": {
                    "id": { "$ref": "#/$defs/id" },
                    "object_type": { "const": "heat_network" },
                    "variant_id": { "$ref": "#/$defs/id" },
                    "start_node_id": { "$ref": "#/$defs/id" },
                    "end_node_id": { "$ref": "#/$defs/id" },
                    "flow_tph": { "$ref": "#/$defs/flow" },
                    "diameter": { "$ref": "#/$defs/diameter" },
                    "length": { "$ref": "#/$defs/length" },
                    "laying_method": { "enum": ["base", "special"] },
                    "cost": { "$ref": "#/$defs/money" },
                    "depth_start": { "$ref": "#/$defs/depth" },
                    "depth_end": { "$ref": "#/$defs/depth" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "tieIn": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "variant_id", "existing_object_id", "existing_object_type", "required_diameter", "cost"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "tie_in" },
                "variant_id": { "$ref": "#/$defs/id" },
                "existing_object_id": { "$ref": "#/$defs/id" },
                "existing_object_type": { "enum": ["heat_network", "heat_chamber"] },
                "existing_diameter": { "$ref": "#/$defs/diameter" },
                "required_diameter": { "$ref": "#/$defs/diameter" },
                "cost": { "$ref": "#/$defs/money" }
              }
            }
          }
        }
      ]
    },
    "networkReconstruction": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/lineString" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "variant_id", "existing_object_id", "existing_flow_tph", "added_flow_tph", "calculated_flow_tph", "existing_diameter", "required_diameter", "length", "cost"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "heat_network_reconstruction" },
                "variant_id": { "$ref": "#/$defs/id" },
                "existing_object_id": { "$ref": "#/$defs/id" },
                "existing_flow_tph": { "$ref": "#/$defs/flow" },
                "added_flow_tph": { "$ref": "#/$defs/flow" },
                "calculated_flow_tph": { "$ref": "#/$defs/flow" },
                "existing_diameter": { "$ref": "#/$defs/diameter" },
                "required_diameter": { "$ref": "#/$defs/diameter" },
                "length": { "$ref": "#/$defs/length" },
                "cost": { "$ref": "#/$defs/money" }
              }
            }
          }
        }
      ]
    },
    "heatChamber": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "variant_id", "diameter", "cost"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "heat_chamber" },
                "variant_id": { "$ref": "#/$defs/id" },
                "diameter": { "$ref": "#/$defs/diameter" },
                "cost": { "$ref": "#/$defs/money" }
              }
            }
          }
        }
      ]
    },
    "chamberReconstruction": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "variant_id", "existing_object_id", "existing_diameter", "required_diameter", "cost"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "heat_chamber_reconstruction" },
                "variant_id": { "$ref": "#/$defs/id" },
                "existing_object_id": { "$ref": "#/$defs/id" },
                "existing_diameter": { "$ref": "#/$defs/diameter" },
                "required_diameter": { "$ref": "#/$defs/diameter" },
                "cost": { "$ref": "#/$defs/money" }
              }
            }
          }
        }
      ]
    },
    "technicalNode": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "$ref": "#/$defs/point" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "variant_id"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "technical_node" },
                "variant_id": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      ]
    },
    "variantSummary": {
      "allOf": [
        { "$ref": "#/$defs/featureEnvelope" },
        {
          "properties": {
            "geometry": { "type": "null" },
            "properties": {
              "type": "object",
              "required": ["id", "object_type", "variant_id", "rank", "construction_cost", "chamber_construction_cost", "tie_in_cost", "reconstruction_cost", "chamber_reconstruction_cost", "unconnected_penalty", "calculated_cost", "new_network_length", "reconstruction_length", "length", "score", "unconnected_oks_ids"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "object_type": { "const": "variant_summary" },
                "variant_id": { "$ref": "#/$defs/id" },
                "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
                "construction_cost": { "$ref": "#/$defs/money" },
                "chamber_construction_cost": { "$ref": "#/$defs/money" },
                "tie_in_cost": { "$ref": "#/$defs/money" },
                "reconstruction_cost": { "$ref": "#/$defs/money" },
                "chamber_reconstruction_cost": { "$ref": "#/$defs/money" },
                "unconnected_penalty": { "$ref": "#/$defs/money" },
                "calculated_cost": { "$ref": "#/$defs/money" },
                "new_network_length": { "$ref": "#/$defs/length" },
                "reconstruction_length": { "$ref": "#/$defs/length" },
                "length": { "$ref": "#/$defs/length" },
                "score": { "type": "number", "minimum": 0 },
                "unconnected_oks_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/id" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
