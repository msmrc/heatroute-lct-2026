{
  "schema_version": "1.0",
  "id": "dff51322-796f-5e6f-8621-b1c40018d3f1",
  "version": 1,
  "name": "Демо-правила — не инженерные нормы",
  "status": "demo",
  "source_references": [
    "Invented exclusively for software tests"
  ],
  "missing_data_policy": {
    "strict": "block_critical_unknowns",
    "exploratory": "only_explicit_assumptions"
  },
  "geometry_tolerances": {
    "precision_m": 0.01,
    "snap_tolerance_m": 0.25,
    "touch_policy": "forbid_except_named_entry_contact"
  },
  "rules": [
    {
      "id": "DEMO-BUILDING-CLEARANCE",
      "type": "clearance",
      "applies_to_kind": "building",
      "parameters": {
        "clearance_m": 3.0,
        "forbid_footprint": true,
        "allow_named_entry_gate": true
      },
      "severity": "blocker",
      "missing_policy": "block",
      "source_reference": "synthetic:not_normative"
    },
    {
      "id": "DEMO-ROAD-PORTAL",
      "type": "crossing_allowed_only_via_portal",
      "applies_to_kind": "road",
      "parameters": {},
      "severity": "blocker",
      "missing_policy": "block",
      "source_reference": "synthetic:not_normative"
    },
    {
      "id": "DEMO-USER-FORBID",
      "type": "hard_exclusion",
      "applies_to_kind": "forbidden_zone",
      "parameters": {
        "clearance_m": 0.0
      },
      "severity": "blocker",
      "missing_policy": "block",
      "source_reference": "synthetic:user_constraint"
    },
    {
      "id": "DEMO-UTILITY-REVIEW",
      "type": "soft_exposure",
      "applies_to_kind": "utility_line",
      "parameters": {
        "metric": "unverified_crossing_count",
        "needs_vertical_review": true
      },
      "severity": "warning",
      "missing_policy": "requires_review",
      "source_reference": "synthetic:not_normative"
    }
  ]
}
